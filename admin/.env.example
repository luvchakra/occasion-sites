# Copy this file to .env for local development (or set these as Environment
# Variables in your Vercel project — same names, same meaning).

# Port the admin tool listens on locally. Unused on Vercel.
PORT=4000

# --- GitHub (required, local AND on Vercel) ------------------------------
# Customer/invoice data, uploaded photos, and published sites are all
# stored in the GitHub repo itself (there's no other persistent storage on
# Vercel) — so a token is needed even when running this locally.
#
# Create a fine-grained Personal Access Token at
# https://github.com/settings/tokens with "Contents: Read and write"
# permission, scoped to just this repo.
GITHUB_TOKEN=
GITHUB_OWNER=luvchakra
GITHUB_REPO=occasion-sites
GITHUB_BRANCH=main

# --- Admin login (recommended once this is deployed publicly) ------------
# Leave both unset to run without a login (fine for local-only use).
ADMIN_USER=
ADMIN_PASSWORD=

# Base public URL where the repo's /sites folder is served (GitHub Pages).
# Used only to show/print the link after publishing.
PUBLIC_BASE_URL=https://luvchakra.github.io/occasion-sites/sites
