# Copy this file to .env and adjust as needed.

# Port the admin tool listens on.
PORT=4000

# Absolute path to a local clone of the occasion-sites repo (the SAME repo
# this admin/ folder lives in is the simplest choice — the default below
# assumes you run the admin tool from inside the repo checkout).
# Publishing writes generated site files under REPO_PATH/sites/<slug>/ and
# runs `git add`, `git commit`, `git push` there using your machine's own
# git/GitHub credentials (nothing is stored by this app).
REPO_PATH=..

# Git branch to commit and push published sites to.
REPO_BRANCH=main

# Base public URL where the repo's /sites folder is served (GitHub Pages).
# Used only to show/print the link after publishing.
PUBLIC_BASE_URL=https://luvchakra.github.io/occasion-sites/sites
